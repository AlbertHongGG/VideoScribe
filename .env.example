# ==========================================
# VideoScribe Application Settings
# ==========================================

# ==========================================
# Agent Configuration
# ==========================================

# --- Translator Agent Settings ---
# Configures the AI used for translating subtitles
# Supported providers: OLLAMA, VERTEX, GEMINIFLOW
TRANSLATOR_AI_PROVIDER=GEMINIFLOW
TRANSLATOR_AI_MODEL=gemini-3.5-flash

# --- Segmenter Agent Settings ---
# Configures the AI used for semantically re-segmenting subtitles
# Supported providers: OLLAMA, VERTEX, GEMINIFLOW
SEGMENTER_AI_PROVIDER=GEMINIFLOW
SEGMENTER_AI_MODEL=gemini-3.5-flash
# Temperature is kept low (e.g. 0.1) for Segmenter to avoid hallucinations
SEGMENTER_TEMPERATURE=0.1

# ==========================================
# Provider-Specific Configurations
# ==========================================

# --- Ollama Settings ---
# Required if any agent uses OLLAMA as its provider
# The URL of your local or remote Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# --- GCP Vertex AI Settings ---
# Required if any agent uses VERTEX as its provider
# Your Google Cloud Project ID and region
VERTEX_PROJECT_ID=your-project-id
VERTEX_REGION=us-central1
# Your GCP Access Token (Run `gcloud auth print-access-token` to get one)
VERTEX_ACCESS_TOKEN=your-access-token

# --- GeminiFlow Settings ---
# Required if any agent uses GEMINIFLOW as its provider
# The URL of your local GeminiFlow server
GEMINIFLOW_BASE_URL=http://127.0.0.1:8000
